{
  "name": "me",
  "author": {
    "name": "Natalia Pospieszyńska"
  },
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "vite dev",
    "eslint": "eslint .",
    "format": "prettier --write . && eslint .",
    "prettier": "prettier --write .",
    "gh-pages": "npm run build && npx gh-pages --dist build --message 'update gh-pages' --dotfiles",
    "gh-pages-help": "npx gh-pages --help",
    "preview": "vite preview",
    "generatePdf": "npx tsx ./scripts/generatePdf.ts"
  },
  "devDependencies": {
    "@eslint/css": "^0.11.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@eslint/json": "^0.13.2",
    "@sveltejs/adapter-auto": "^6.1.0",
    "@sveltejs/adapter-static": "^3.0.9",
    "@sveltejs/kit": "^2.39.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@types/markdown-it": "^14.1.2",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-svelte": "^3.12.3",
    "gh-pages": "^6.3.0",
    "globals": "^16.4.0",
    "jiti": "^2.5.1",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "puppeteer": "^24.20.0",
    "sass": "^1.92.1",
    "svelte": "^5.38.10",
    "svelte-check": "^4.3.1",
    "svelte-preprocess": "^6.0.3",
    "tslib": "^2.8.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.5",
    "vite-plugin-devtools-json": "^1.0.0"
  },
  "dependencies": {
    "@lucide/svelte": "^0.544.0",
    "@picocss/pico": "^2.1.1",
    "isomorphic-dompurify": "^2.26.0",
    "markdown-it": "^14.1.0"
  }
}
